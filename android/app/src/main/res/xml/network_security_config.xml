<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP only to the local dev backend, for testing with `npm run build:local-mobile`. Production builds use HTTPS and never hit this. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.193</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
